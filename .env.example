# Configuración de Variables de Entorno
# Copia este archivo a .env y ajusta los valores según tu entorno

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=5000

# Site Configuration
REACT_APP_SITE_NAME=MeBu
REACT_APP_SITE_URL=https://mebu.com

# Contact Information
REACT_APP_CONTACT_EMAIL=info@mebu.com
REACT_APP_CONTACT_PHONE=+1234567890

# Analytics (opcional)
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Social Media
REACT_APP_FACEBOOK_URL=https://facebook.com/mebu
REACT_APP_TWITTER_URL=https://twitter.com/mebu
REACT_APP_LINKEDIN_URL=https://linkedin.com/company/mebu
REACT_APP_INSTAGRAM_URL=https://instagram.com/mebu

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_CHATBOT=false
